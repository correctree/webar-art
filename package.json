{
  "name": "webar-art",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/copy-space-page.mjs && node scripts/build-studio-assets.mjs && vite build --config vite.studio.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "npm run build && python3 -m http.server 8080 --directory dist",
    "target:prepare": "node scripts/prepare-target.mjs",
    "target:import": "node scripts/import-target.mjs",
    "install:repo": "node scripts/install-repo.mjs",
    "start": "node --env-file-if-exists=.env publisher/server.mjs"
  },
  "dependencies": {
    "three": "0.160.1",
    "@8thwall/engine-binary": "1.0.0",
    "mind-ar": "1.2.5",
    "jszip": "3.10.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@8thwall/image-target-cli": "1.0.0",
    "vite": "6.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
